// Pythagorean triples: right triangles with whole-number sides, a² + b² = c².
//
// `solve all` enumerates every solution; the body runs once per triple and may update
// ordinary variables, like the counter below.

var limit = 30
var a, b, c: int[1..=limit]

require a < b                  // each triangle once
require a * a + b * b == c * c

var count = 0
solve all a, b, c {
    print "{a}² + {b}² = {c}²"
    count = count + 1
}
print "{count} triples with sides up to {limit}"

// Output:
// 18² + 24² = 30²
// 6² + 8² = 10²
// 9² + 12² = 15²
// 10² + 24² = 26²
// 8² + 15² = 17²
// 7² + 24² = 25²
// 15² + 20² = 25²
// 12² + 16² = 20²
// 5² + 12² = 13²
// 3² + 4² = 5²
// 20² + 21² = 29²
// 11 triples with sides up to 30
