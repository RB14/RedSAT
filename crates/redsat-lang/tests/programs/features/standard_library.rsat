// Every standard library function, on known values and on unknowns.
print sign(-5), sign(0), sign(7), clamp(15, 0, 10), clamp(-3, 0, 10), divides(3, 12), is_even(4), is_odd(4)
print gcd(84, 36), digits(4096, 4), digit_sum(4096, 4), bit(6, 1), popcount(255, 8)
print exactly(2, [true, false, true]), at_least(3, [true, false, true]), at_most(1, [false, false, true])
print count_of([1, 2, 1, 3], 1), product([2, 3, 7]), all_equal([4, 4, 4]), increasing([1, 2, 2]), strictly_increasing([1, 2, 2])
print decreasing([3, 2, 2]), strictly_decreasing([3, 2, 1]), all_different_except([0, 1, 0, 2], 0), index_of([5, 7, 9], 9), index_of([5, 7], 8)
print lex_less([1, 2], [1, 3]), lex_less([1, 3], [1, 3]), lex_less_eq([1, 3], [1, 3]), sorted([3, 1, 2]), is_permutation([1, 2, 3], [3, 1, 2])
print is_digit('7'), is_lower('a'), is_upper('a'), is_letter('Z'), to_upper('q'), to_lower('Q'), digit_value('8')
print starts_with("hello", "he"), ends_with("hello", "lo"), count_char("banana", 'a'), [1, 2] + [3]

// A four-digit number with strictly increasing digits that are a permutation of 4, 1, 3, 2.
var n: int[1000..=9999]
require is_permutation(digits(n, 4), [4, 1, 3, 2])
require strictly_increasing(digits(n, 4))
solve n

// A word of 4 to 6 lowercase letters starting with "ab", ending with "ba", with three 'a'.
var w: string[4..=6]
require all(is_lower(c) for c in w)
require starts_with(w, "ab") and ends_with(w, "ba") and count_char(w, 'a') == 3
solve w

// Sorting unknowns: three digits whose sorted form is [2, 5, 7], the first larger than the last.
var xs: [int[0..=9]; 3]
require sorted(xs) == [2, 5, 7] and xs[0] > xs[2]
solve all xs
