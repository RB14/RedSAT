// Bit manipulation: find the 8-bit numbers whose bits read the same in both directions and
// that have exactly four ones, then list them in binary.

var x: uint<8>

fn bit(x: int, i: int) -> int {
    return (x >> i) & 1
}

require all(bit(x, i) == bit(x, 7 - i) for i in 0..4)
require count(bit(x, i) == 1 for i in 0..8) == 4

solve all x {
    print "{x}: {binary(x)}"
}

fn binary(x: int) -> string {
    var digits = ""
    for i in 0..8 {
        digits = (if bit(x, i) == 1 { "1" } else { "0" }) + digits
    }
    return digits
}

// Output:
// 60: 00111100
// 195: 11000011
// 102: 01100110
// 165: 10100101
// 90: 01011010
// 153: 10011001
