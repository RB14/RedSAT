// Sudoku: fill the grid so that every row, column and 3×3 box contains the digits 1–9.
//
// The grid mixes known digits with `?`: each `?` is an anonymous unknown whose type (a digit
// from 1 to 9) comes from the declaration. One `all_different` per row, column and box does
// the rest, and `solve unique` also proves that the puzzle has exactly one solution.

var grid: [[int[1..=9]; 9]; 9] = [
    [5, 3, ?,  ?, 7, ?,  ?, ?, ?],
    [6, ?, ?,  1, 9, 5,  ?, ?, ?],
    [?, 9, 8,  ?, ?, ?,  ?, 6, ?],
    [8, ?, ?,  ?, 6, ?,  ?, ?, 3],
    [4, ?, ?,  8, ?, 3,  ?, ?, 1],
    [7, ?, ?,  ?, 2, ?,  ?, ?, 6],
    [?, 6, ?,  ?, ?, ?,  2, 8, ?],
    [?, ?, ?,  4, 1, 9,  ?, ?, 5],
    [?, ?, ?,  ?, 8, ?,  ?, 7, 9],
]

for i in 0..9 {
    require all_different(grid[i])                                  // row i
    require all_different([grid[r][i] for r in 0..9])               // column i
    var top = i / 3 * 3
    var left = i % 3 * 3
    require all_different([grid[top + r][left + c] for r in 0..3 for c in 0..3])   // box i
}

solve unique grid {
    for row in grid {
        print row
    }
}

// Output:
// [5, 3, 4, 6, 7, 8, 9, 1, 2]
// [6, 7, 2, 1, 9, 5, 3, 4, 8]
// [1, 9, 8, 3, 4, 2, 5, 6, 7]
// [8, 5, 9, 7, 6, 1, 4, 2, 3]
// [4, 2, 6, 8, 5, 3, 7, 9, 1]
// [7, 1, 3, 9, 2, 4, 8, 5, 6]
// [9, 6, 1, 5, 3, 7, 2, 8, 4]
// [2, 8, 7, 4, 1, 9, 6, 3, 5]
// [3, 4, 5, 2, 8, 6, 1, 7, 9]
