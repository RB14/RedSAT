// "AI Escargot", a Sudoku once advertised as the hardest for humans.
var givens = [
    [1, 0, 0,  0, 0, 7,  0, 9, 0],
    [0, 3, 0,  0, 2, 0,  0, 0, 8],
    [0, 0, 9,  6, 0, 0,  5, 0, 0],
    [0, 0, 5,  3, 0, 0,  9, 0, 0],
    [0, 1, 0,  0, 8, 0,  0, 0, 2],
    [6, 0, 0,  0, 0, 4,  0, 0, 0],
    [3, 0, 0,  0, 0, 0,  0, 1, 0],
    [0, 4, 0,  0, 0, 0,  0, 0, 7],
    [0, 0, 7,  0, 0, 0,  3, 0, 0],
]
var grid: [[int[1..=9]; 9]; 9]
for r in 0..9 {
    for c in 0..9 {
        if givens[r][c] != 0 { require grid[r][c] == givens[r][c] }
    }
}
for i in 0..9 {
    require all_different(grid[i])
    require all_different([grid[r][i] for r in 0..9])
    require all_different([grid[i / 3 * 3 + r][i % 3 * 3 + c] for r in 0..3 for c in 0..3])
}
solve unique grid { print grid[0] }
